      "theme": { "words": ["Falke", "Eule"], "genders": ["m", "f"], "language": "de" },
      "recipe": { "theme_word": "Falke", "adjective": "still", "verb": "jagend", "agent": "läufer", "pattern_index": 2 },
      "word_count": 2, "language": "de",
      "expected": { "name": "Falke Läufer", "slug": "falke-laeufer", "pattern": "theme-agent", "sources": ["Falke", "läufer"] }
    },
    {
